# Settings for the new website (web/). Copy to web/.env.local for local work,
# or set these in your host's dashboard (Vercel, Netlify, ...). Both are public:
# NEXT_PUBLIC_ values are built into the pages people download.

# Where the backend API runs. No key is needed: the backend sets login cookies itself.
NEXT_PUBLIC_API_URL=http://localhost:3001

# This website's own address. Used for link previews (WhatsApp, X, LinkedIn) and shared links.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# The site name lives in web/lib/brand.ts, not here, so it is the same on every page.

# ---------------------------------------------------------------------------
# The backend (backend/.env) also needs these for this website to work fully:
#
# CORS_ORIGIN=https://current-site.example,https://new-site.example
#     Comma-separated. Every site that calls the API must be listed.
# FRONTEND_URL=https://new-site.example
#     Where emails, certificates' verify links and notifications send people.
# LEGACY_FRONTEND_URL=https://current-site.example
#     For pages only the current site has (admin, sponsors, premium, hackathon judging).
# GOOGLE_REDIRECT_URIS=https://new-site.example/oauth/google/callback
#     Also add this address in Google Cloud console > Credentials > OAuth client.
# COOKIE_DOMAIN=.example.com    (and COOKIE_SAMESITE=none if the API is on another domain)
#     So one login works on both sites.
# BRAND_NAME=OnTheRoll
# BRAND_COLOR=#0A7A50
#     The name and colour in emails and certificate PDFs.
#
# Outside the code: your Cloudflare R2 bucket's CORS policy must allow this website's
# address, or uploaded certificate designs cannot be saved as images.
