# The backend (same one the current site uses). Login cookies are shared, so signing in on either site works on both.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Pages not rebuilt yet open on the current site. Required when deploying web2.
# For local work, run `npm run dev:web2` from the repository root to start both sites.
NEXT_PUBLIC_CLASSIC_URL=http://localhost:3002
